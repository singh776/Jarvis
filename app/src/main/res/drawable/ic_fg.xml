<?xml version="1.0" encoding="utf-8"?>
<!-- Singh AI launcher icon (original design): glowing gradient orb, ring, and a bold "S" -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- soft glow -->
    <path android:pathData="M54,54m-32,0a32,32 0,1 1,64 0a32,32 0,1 1,-64 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="54"
                android:gradientRadius="32"
                android:startColor="#B39B72FF"
                android:centerColor="#554C8DFF"
                android:endColor="#004C8DFF" />
        </aapt:attr>
    </path>

    <!-- gradient ring -->
    <path
        android:pathData="M54,54m-25,0a25,25 0,1 1,50 0a25,25 0,1 1,-50 0"
        android:strokeWidth="3.2"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="29" android:startY="29"
                android:endX="79" android:endY="79"
                android:startColor="#FF4C8DFF"
                android:centerColor="#FF9B72FF"
                android:endColor="#FFFF5FA2" />
        </aapt:attr>
    </path>

    <!-- bold S -->
    <path
        android:pathData="M64.5,41.5 C61,37.5 55.5,36.5 51,37.6 C45.5,39 43.3,44 46,48 C48.8,52 60.5,53.2 62.4,58.6 C64.3,64 59.5,69.6 52.8,69.8 C48.4,70 44.6,68.2 42.2,65.2"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeColor="#FFFFFFFF"
        android:fillColor="#00000000" />

    <!-- little spark -->
    <path
        android:pathData="M75,27 Q75.8,32.2 81,33 Q75.8,33.8 75,39 Q74.2,33.8 69,33 Q74.2,32.2 75,27 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="69" android:startY="27"
                android:endX="81" android:endY="39"
                android:startColor="#FFFFFFFF"
                android:endColor="#FFFF8FC0" />
        </aapt:attr>
    </path>
</vector>
